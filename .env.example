# サーバーのポート番号
PORT=3800

# 記録先の Obsidian markdown ファイルの絶対パス
OBSIDIAN_FILE_PATH=C:\Users\yourname\Documents\Obsidian\aibou-techo.md

# Notion Integration の Secret（notion.so/my-integrations で発行）
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 記録先の Notion ページID（URLの32桁のハイフン無しID、またはハイフン付きどちらでも可）
NOTION_PAGE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI APIキー（音声入力の文字起こし・「話すだけで記録」の項目自動判定に使用）
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- Web版（自前DBモード） --------------------------------------------------
# STORAGE=pg にすると、Notionではなく自前のPostgresに保存し、ログインが必須になる。
# 未設定（または pg 以外）なら従来どおり「利用者のNotion」に保存する。
STORAGE=

# Postgres の接続文字列（Supabase の "Connection string" / Render Postgres など）
DATABASE_URL=postgres://user:password@host:5432/dbname

# ログイン画面（login.html）がブラウザから Supabase Auth を呼ぶための公開情報
#   Supabase の Project Settings → API の「Project URL」と「anon public」キー
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ログインの検証。Supabase Auth のどちらか一方を設定する
#   - 共有鍵（HS256）: Supabase の Project Settings → API → JWT Secret
#   - 公開鍵（JWKS）:  https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_SECRET=
SUPABASE_JWKS_URL=

# （任意）アカウント削除の時に、認証側（Supabase Auth）の利用者も一緒に消すための鍵。
#   Project Settings → API の「service_role」キー。サーバーだけが持つ。無ければ記録だけ消す
SUPABASE_SERVICE_ROLE_KEY=

# （任意）無料枠の回数。省略時は 音声20回/月・ふりかえり3回/週・チャット15回/週
AI_FREE_VOICE_LIMIT=
AI_FREE_REVIEW_LIMIT=
AI_FREE_CHAT_LIMIT=
